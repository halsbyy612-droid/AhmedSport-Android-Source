<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ahmed_background"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ahmed_background"
        app:show_buffering="always"
        app:show_timeout="3500"
        app:use_controller="true" />

    <TextView
        android:id="@+id/playerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="18dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/pill_background"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="12dp"
        android:paddingBottom="7dp"
        android:text="قناة أحمد سبورت 1"
        android:textColor="@color/ahmed_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/muteButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="68dp"
        android:background="@drawable/circle_button_background"
        android:contentDescription="كتم الصوت"
        android:padding="10dp"
        android:src="@drawable/ic_volume"
        android:tint="@color/ahmed_text_primary" />

    <ImageButton
        android:id="@+id/fullscreenButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/circle_button_background"
        android:contentDescription="ملء الشاشة"
        android:padding="10dp"
        android:src="@drawable/ic_fullscreen"
        android:tint="@color/ahmed_text_primary" />

    <LinearLayout
        android:id="@+id/statusPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="28dp"
        android:background="@drawable/status_panel_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/loadingIndicator"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="@color/ahmed_green" />

        <TextView
            android:id="@+id/statusMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="@color/ahmed_text_primary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="إعادة المحاولة"
            android:textAllCaps="false"
            android:textColor="@color/ahmed_background" />
    </LinearLayout>
</FrameLayout>
